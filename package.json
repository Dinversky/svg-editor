{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript CLI SVG editor, developed incrementally for Lab1.",
  "main": "dist/cli/main.js",
  "scripts": {
    "start": "node dist/cli/main.js",
    "cli": "npm run build && node dist/cli/main.js",
    "dev": "node --experimental-strip-types src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/cli.test.mjs test/tokenizer.test.mjs test/command-registry.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "doc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
